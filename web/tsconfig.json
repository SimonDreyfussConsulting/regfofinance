{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "..",
    "paths": {
      "@/*": ["web/*"],
      "@db/*": ["db/*"],
      "@ingestion/*": ["ingestion/*"],
      "@normalization/*": ["normalization/*"],
      "@gateway/*": ["gateway/*"],
      "@ops/*": ["ops/*"],
      "@intelligence/*": ["intelligence/*"],
      "@advisor/*": ["advisor/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../db/**/*.ts",
    "../normalization/**/*.ts",
    "../ingestion/**/*.ts",
    "../gateway/**/*.ts",
    "../ops/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

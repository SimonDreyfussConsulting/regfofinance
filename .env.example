# Commonwealth Main environment template.
# Copy this file to .env and fill in local values. Never commit a real .env.
# Only placeholder names live here. No real secret values, ever.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres brought up by docker-compose.yml.
DATABASE_URL=postgresql://commonwealth:commonwealth@localhost:5432/commonwealth

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
# filler: app runs entirely on seed data and makes no external calls (default, safe).
# live:   recognized but inert in Phase 1. Live connectors are stubs that throw.
DATA_MODE=filler

# ---------------------------------------------------------------------------
# Secrets provider selector
# ---------------------------------------------------------------------------
# env: read secrets from process.env (local development).
# aws: read secrets from AWS Secrets Manager (production, stubbed in Phase 1).
SECRETS_PROVIDER=env

# AWS Secrets Manager settings. Only used when SECRETS_PROVIDER=aws.
# Placeholders only. Do not put real values here.
AWS_REGION=us-east-1
AWS_SECRETS_PREFIX=commonwealth/

# ---------------------------------------------------------------------------
# LLM gateway
# ---------------------------------------------------------------------------
# Model identifier the gateway should route to. Leave empty to keep the
# gateway unconfigured, in which case complete() returns a clear
# "gateway not configured" result. Phase 1 ships with no provider wired.
LLM_MODEL=
# Placeholder name only. The real key is resolved through the secrets provider.
LLM_API_KEY=
